{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "azura-mua-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-15",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_ENV": "development",
    "ALLOWED_ORIGIN": "http://localhost:8080",
    "REQUIRE_AUTH": "false"
  },
  "r2_buckets": [
    {
      "binding": "PUBLIC_BUCKET",
      "bucket_name": "azura-mua-public"
    },
    {
      "binding": "PRIVATE_BUCKET",
      "bucket_name": "azura-mua-private"
    }
  ],
  "observability": {
    "enabled": true
  },
  "env": {
    "production": {
      "name": "azura-mua-api-production",
      "vars": {
        "APP_ENV": "production",
        "ALLOWED_ORIGIN": "https://azura.daysheet.id",
        "REQUIRE_AUTH": "false"
      },
      "r2_buckets": [
        {
          "binding": "PUBLIC_BUCKET",
          "bucket_name": "azura-mua-public"
        },
        {
          "binding": "PRIVATE_BUCKET",
          "bucket_name": "azura-mua-private"
        }
      ]
    }
  }
}
